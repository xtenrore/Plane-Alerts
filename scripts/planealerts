#!/usr/bin/env python3
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

if len(sys.argv) > 1 and sys.argv[1] == "shadow-eval":
    from app.shadow_report_v52 import main as shadow_main  # noqa: E402

    raise SystemExit(shadow_main(sys.argv[2:]))

if len(sys.argv) > 1 and sys.argv[1] in {"diagnostics", "metrics"}:
    from app.observability_v50 import main as observability_main  # noqa: E402

    raise SystemExit(observability_main(sys.argv[1:]))

# app.doctor_v49 was the original self-hosting doctor entry point. v5.5 keeps
# that operator contract while routing the command through the backend-aware,
# AGY-free community doctor below.
from app.doctor_v55 import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
