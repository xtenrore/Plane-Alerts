# =============================================================================
# Plane Alerts v5.5.0 - community self-hosting configuration template
# =============================================================================
# The guided installer creates .env for you. This file remains an unconfigured
# reference only. Never commit a configured .env or paste secrets into issues.

# --- Community runtime ---
# Community installs use app.community_main_v55 so private AGY tooling is never
# imported, configured, started or authenticated.
PLANE_ALERTS_COMMUNITY_SELF_HOST=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Database ---
# Recommended personal self-hosting backend: sqlite
# Alternatives: mongodb
DATABASE_BACKEND=sqlite
SQLITE_PATH=
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=aircraft_bot

# --- Public aircraft data providers ---
ADSB_LOL_BASE_URL=https://api.adsb.lol/v2
ADSB_FI_BASE_URL=https://opendata.adsb.fi/api/v2
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live/v2
ADSB_ONE_BASE_URL=https://api.adsb.one/v2
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# OpenSky OAuth2 client credentials are optional. Each slot accepts either:
#   clientId:clientSecret
# or JSON containing clientId/clientSecret. Leave every slot blank to skip.
OPENSKY_1=
OPENSKY_2=
OPENSKY_3=
OPENSKY_4=
OPENSKY_5=
OPENSKY_CREDENTIALS_JSON=
API_KEYS_DIR=api

# --- Optional local ADS-B receiver ---
# Supported receiver families: auto, readsb, dump1090, dump1090-fa, ultrafeeder
LOCAL_ADSB_URL=
LOCAL_ADSB_RECEIVER_TYPE=auto
LOCAL_ADSB_TIMEOUT_SECONDS=0.8
LOCAL_ADSB_MAX_POSITION_AGE_SECONDS=12
LOCAL_ADSB_AUTH_HEADER=
# Receiver coordinates describe the antenna/receiver coverage only. They are
# never used as a Telegram alert/profile location.
LOCAL_ADSB_RECEIVER_LATITUDE=
LOCAL_ADSB_RECEIVER_LONGITUDE=
LOCAL_ADSB_RECEIVER_COVERAGE_KM=

# --- Optional photography / explanation services ---
# These are enrichment-only. They never decide trajectory/CPA/ETA/alert timing.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_SECONDARY=gemini-3.5-flash
GEMINI_PHOTO_MODEL=gemini-3.8-flash
GEMINI_PHOTO_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_PHOTO_TIMEOUT_SECONDS=30
GROQ_KEY=
GROQ_KEY_2=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_CONTRAILS_API_KEY=

# --- Open-Meteo photography conditions ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
PHOTOGRAPHY_HTTP_TIMEOUT_SECONDS=12
PHOTOGRAPHY_CONDITIONS_CACHE_SECONDS=120

# --- Monitoring ---
POLL_INTERVAL_SECONDS=5
DEFAULT_RADIUS_KM=15.0
COOLDOWN_MINUTES=30
LEARNING_PLANE_THRESHOLD=100
RELEARN_PLANE_COUNT=25

# --- v5.2 shadow evaluation (evaluation-only; never selects live model) ---
PLANE_SHADOW_EVALUATION_ENABLED=true
PLANE_SHADOW_V46_LINEAR_ENABLED=true
PLANE_SHADOW_V46_TURN_ENABLED=true

# --- Admin ---
ADMIN_TELEGRAM_ID=
ADMIN_PASSWORD=

# AGY is intentionally not configurable in the community installer/runtime.
# Owner/private AGY deployment variables are not part of community setup.

# --- Server ---
HOST=0.0.0.0
PORT=8000
PLANE_ALERTS_PORT=8000
LOG_LEVEL=INFO
