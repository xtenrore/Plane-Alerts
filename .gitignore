# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
groq.txt

# Community installer runtime state, local SQLite data and rollback backups
.community/
plane-alerts-data/

# Provider credentials - never commit live credentials
api/*.json
!api/.gitkeep
credentials*.json
*_credentials.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Deployment metadata generated from the exact tested SHA before Railway upload
app/build_commit.txt

# Generated worldwide aviation reference database. The pinned source manifest
# and maintained overrides are versioned; the SQLite binary is rebuilt by CI/image builds.
data/aviation/compiled/*.sqlite3
data/aviation/compiled/*.sqlite3.tmp

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Database backups
backup/
*.dump

# Pytest
.pytest_cache/
.coverage
htmlcov/
