FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/control/package.json apps/control/package.json
RUN npm install --include=dev
COPY packages/shared packages/shared
COPY apps/control apps/control
RUN npm run build -w @akmp/shared && npm run build -w @akmp/control && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=4000
WORKDIR /app
RUN useradd --system --uid 10001 --create-home akmp
COPY --from=build --chown=akmp:akmp /app/node_modules ./node_modules
COPY --from=build --chown=akmp:akmp /app/packages/shared ./packages/shared
COPY --from=build --chown=akmp:akmp /app/apps/control ./apps/control
USER akmp
EXPOSE 4000
CMD ["node", "apps/control/dist/server.js"]
