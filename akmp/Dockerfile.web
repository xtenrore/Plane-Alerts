FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm install --include=dev
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN npm run build -w @akmp/shared && npm run build -w @akmp/web

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
RUN useradd --system --uid 10001 --create-home akmp
COPY --from=build --chown=akmp:akmp /app/apps/web/.next/standalone ./
COPY --from=build --chown=akmp:akmp /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=akmp:akmp /app/apps/web/public* ./apps/web/public/
USER akmp
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
